{
  "name": "tailwind-plus-mcp",
  "version": "1.0.0",
  "description": "Read-only local MCP access to user-supplied licensed Tailwind Plus assets",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "start": "next start --hostname 0.0.0.0",
    "test": "node --test",
    "demo": "node src/cli.js serve --root examples/assets",
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start:web": "npm start",
    "start:stdio": "node src/cli.js serve",
    "diagnose": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/diagnose.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tailwind-plus-local": "src/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.4.0",
    "zod": "3.25.76"
  }
}
